<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global, not frontend: Luma's checkout places the order through the
         REST API and headless shops through GraphQL, each its own area. -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="recapi_order_placed" instance="Recapi\Recommendations\Observer\OrderPlaced"/>
    </event>
    <!-- Products change in the admin, through the REST API and in scripts. -->
    <event name="catalog_product_save_after">
        <observer name="recapi_product_saved" instance="Recapi\Recommendations\Observer\ProductChanged"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="recapi_product_deleted" instance="Recapi\Recommendations\Observer\ProductChanged"/>
    </event>
</config>
