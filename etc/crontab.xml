<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Nightly: recapi stores only what changed, so a full send is cheap. -->
        <job name="recapi_sync_catalog" instance="Recapi\Recommendations\Cron\SyncCatalog" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
