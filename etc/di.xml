<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="recapi_sync_catalog" xsi:type="object">Recapi\Recommendations\Console\SyncCatalog</item>
            </argument>
        </arguments>
    </type>
    <type name="Recapi\Recommendations\Console\SyncCatalog">
        <arguments>
            <argument name="catalog" xsi:type="object">Recapi\Recommendations\Model\Catalog\Proxy</argument>
        </arguments>
    </type>
    <!-- The storefront's script loads the JS library from the store view's API
         host: allowed in Magento's CSP after its own config, csp_whitelist.xml
         and inline-script collectors, before the controllers' changes. Here,
         not in etc/frontend/di.xml: an area's array argument replaces the
         global one instead of joining it, which dropped Magento's collectors
         and with them the storefront's whole policy. The collector itself
         adds the host on the storefront only. -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="recapi" xsi:type="object" sortOrder="50">Recapi\Recommendations\Model\CspPolicyCollector</item>
            </argument>
        </arguments>
    </type>
</config>
